# AMAL production deployment template
AMAL_ENV=production
# For this release candidate, use a dedicated managed/hosted database path only for controlled SQLite pilots.
AMAL_DB_PATH=/var/lib/amal/amal.db
AMAL_MAX_REQUEST_BYTES=2097152
# Set these through a real secrets manager in production; do not commit secrets.
AMAL_SECRET_KEY=REPLACE_IN_SECRET_MANAGER
